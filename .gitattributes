# Auto detect text files and perform LF normalization
* text=auto

# C++ Source Files
*.c     text diff=c
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.cpp   text diff=cpp
*.c++   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp
*.h++   text diff=cpp
*.hh    text diff=cpp

# Shell scripts must keep LF endings for bash, batch files CRLF for cmd.exe
tools/build/ob-build text eol=lf
*.cmd text eol=crlf
