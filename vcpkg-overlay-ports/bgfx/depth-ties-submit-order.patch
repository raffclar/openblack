+		/// The key that sorts a render item: its submit key with the view remapped. In a view whose draws of equal
+		/// depth keep their submit order, a draw sorted by depth sorts by its depth alone.
+		uint64_t sortKey(uint64_t _submitKey) const
+		{
+			const uint64_t key = SortKey::remapView(_submitKey, const_cast<ViewId*>(m_viewOrder) );
+			if ( (kSortKeyDrawBit | kSortKeyDrawTypeDepth) != (key & (kSortKeyDrawBit | kSortKeyDrawTypeMask) ) )
+			{
+				return key;
+			}
+
+			const ViewId id = SortKey::decodeView(_submitKey);
+			if (0 == (m_viewDepthTies[uint32_t(id) >> 6] & (uint64_t(1) << (id & 0x3f) ) ) )
+			{
+				return key;
+			}
+
+			return key & (kSortKeyViewMask | kSortKeyDrawBit | kSortKeyDrawTypeMask | kSortKeyDraw1DepthMask);
+		}
