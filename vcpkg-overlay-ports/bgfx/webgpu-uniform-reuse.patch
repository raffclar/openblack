+	// Compares 8 bytes at a time. The byte loop of memCmp costs more for the uniform blocks of each draw.
+	static bool sameBytes(const uint8_t* _a, const uint8_t* _b, uint32_t _size)
+	{
+		uint32_t ii = 0;
+
+		for (; ii + 8 <= _size; ii += 8)
+		{
+			uint64_t aa;
+			uint64_t bb;
+			memcpy(&aa, &_a[ii], 8);
+			memcpy(&bb, &_b[ii], 8);
+
+			if (aa != bb)
+			{
+				return false;
+			}
+		}
+
+		for (; ii < _size; ++ii)
+		{
+			if (_a[ii] != _b[ii])
+			{
+				return false;
+			}
+		}
+
+		return true;
+	}
