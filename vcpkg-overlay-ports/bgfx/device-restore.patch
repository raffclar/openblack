+
+#ifndef BGFX_DEVICE_RESTORE_H_HEADER_GUARD
+#define BGFX_DEVICE_RESTORE_H_HEADER_GUARD
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace bgfx
+{
+	bool isMemoryRef(const Memory* _mem);
+
+	// Keeps what the render thread needs to make each live resource again on a new renderer, after the device
+	// is lost or when the application asks for it. Each resource keeps the data of its create command. The
+	// changes to textures and dynamic buffers go into kept copies. A new renderer then gets the same handles,
+	// thus the application keeps its handles. All functions run on the render thread.
+	class DeviceRestore
+	{
+	public:
+		DeviceRestore()
+			: m_indexBuffers(BGFX_CONFIG_MAX_INDEX_BUFFERS)
+			, m_vertexLayouts(BGFX_CONFIG_MAX_VERTEX_LAYOUTS)
+			, m_vertexBuffers(BGFX_CONFIG_MAX_VERTEX_BUFFERS)
+			, m_dynamicIndexBuffers(BGFX_CONFIG_MAX_INDEX_BUFFERS)
+			, m_dynamicVertexBuffers(BGFX_CONFIG_MAX_VERTEX_BUFFERS)
+			, m_shaders(BGFX_CONFIG_MAX_SHADERS)
+			, m_programs(BGFX_CONFIG_MAX_PROGRAMS)
+			, m_textures(BGFX_CONFIG_MAX_TEXTURES)
+			, m_frameBuffers(BGFX_CONFIG_MAX_FRAME_BUFFERS)
+			, m_uniforms(BGFX_CONFIG_MAX_UNIFORMS)
+		{
+		}
+
+		~DeviceRestore()
+		{
+			clear();
+		}
+
+		// The kinds of kept data
+		enum Kept
+		{
+			KeptBuffers,
+			KeptDynamicBuffers,
+			KeptShaders,
+			KeptTextures,
+			KeptTextureChanges,
+
+			KeptCount
+		};
+
+		// The number of bytes of resource data that are kept
+		uint64_t keptBytes() const
+		{
+			uint64_t sum = 0;
+			for (uint64_t bytes : m_kept)
+			{
+				sum += bytes;
+			}
+
+			return sum;
+		}
+
+		// The number of bytes of one kind of kept data
+		uint64_t keptBytes(Kept _kind) const
+		{
+			return m_kept[_kind];
+		}
+
+		void createIndexBuffer(IndexBufferHandle _handle, const Memory* _mem, uint16_t _flags)
+		{
+			Buffer& buffer = m_indexBuffers[_handle.idx];
+			freeBuffer(buffer, KeptBuffers);
+			buffer.mem   = own(_mem);
+			buffer.size  = buffer.mem->size;
+			buffer.flags = _flags;
+			m_kept[KeptBuffers] += buffer.mem->size;
+		}
+
+		void destroyIndexBuffer(IndexBufferHandle _handle)
+		{
+			freeBuffer(m_indexBuffers[_handle.idx], KeptBuffers);
+		}
+
+		// The application gives the contents of the buffer again after a restore. The kept contents go.
+		void restoreByApplication(IndexBufferHandle _handle)
+		{
+			giveUpContents(m_indexBuffers[_handle.idx]);
+		}
+
+		// Makes a buffer that the application gives again with the new contents. The caller keeps the memory.
+		void giveContents(RendererContextI* _renderCtx, IndexBufferHandle _handle, const Memory* _mem)
+		{
+			const Buffer& buffer = m_indexBuffers[_handle.idx];
+			if (!buffer.byApplication)
+			{
+				return;
+			}
+
+			_renderCtx->destroyIndexBuffer(_handle);
+			_renderCtx->createIndexBuffer(_handle, _mem, buffer.flags);
+		}
+
+		void createVertexLayout(VertexLayoutHandle _handle, const VertexLayout& _layout)
+		{
+			m_vertexLayouts[_handle.idx].live   = true;
+			m_vertexLayouts[_handle.idx].layout = _layout;
+		}
+
+		void destroyVertexLayout(VertexLayoutHandle _handle)
+		{
+			m_vertexLayouts[_handle.idx].live = false;
+		}
+
+		void createVertexBuffer(VertexBufferHandle _handle, const Memory* _mem, VertexLayoutHandle _layoutHandle, uint16_t _flags)
+		{
+			Buffer& buffer = m_vertexBuffers[_handle.idx];
+			freeBuffer(buffer, KeptBuffers);
+			buffer.mem    = own(_mem);
+			buffer.size   = buffer.mem->size;
+			buffer.layout = _layoutHandle;
+			buffer.flags  = _flags;
+			m_kept[KeptBuffers] += buffer.mem->size;
+		}
+
+		void destroyVertexBuffer(VertexBufferHandle _handle)
+		{
+			freeBuffer(m_vertexBuffers[_handle.idx], KeptBuffers);
+		}
+
+		// The application gives the contents of the buffer again after a restore. The kept contents go.
+		void restoreByApplication(VertexBufferHandle _handle)
+		{
+			giveUpContents(m_vertexBuffers[_handle.idx]);
+		}
+
+		// Makes a buffer that the application gives again with the new contents. The caller keeps the memory.
+		void giveContents(RendererContextI* _renderCtx, VertexBufferHandle _handle, const Memory* _mem)
+		{
+			const Buffer& buffer = m_vertexBuffers[_handle.idx];
+			if (!buffer.byApplication)
+			{
+				return;
+			}
+
+			_renderCtx->destroyVertexBuffer(_handle);
+			_renderCtx->createVertexBuffer(_handle, _mem, buffer.layout, buffer.flags);
+		}
+
+		void createDynamicIndexBuffer(IndexBufferHandle _handle, uint32_t _size, uint16_t _flags)
+		{
+			createDynamic(m_dynamicIndexBuffers[_handle.idx], _size, _flags);
+		}
+
+		void updateDynamicIndexBuffer(IndexBufferHandle _handle, uint32_t _offset, uint32_t _size, const Memory* _mem)
+		{
+			updateDynamic(m_dynamicIndexBuffers[_handle.idx], _offset, _size, _mem);
+		}
+
+		void destroyDynamicIndexBuffer(IndexBufferHandle _handle)
+		{
+			freeDynamic(m_dynamicIndexBuffers[_handle.idx]);
+		}
+
+		// The application gives the bytes of a range of the buffer again after a restore, or stops when the range
+		// goes. The kept bytes of the range go.
+		void restoreByApplication(IndexBufferHandle _handle, uint32_t _offset, uint32_t _size, bool _on)
+		{
+			markDynamic(m_dynamicIndexBuffers[_handle.idx], _offset, _size, _on);
+		}
+
+		void createDynamicVertexBuffer(VertexBufferHandle _handle, uint32_t _size, uint16_t _flags)
+		{
+			createDynamic(m_dynamicVertexBuffers[_handle.idx], _size, _flags);
+		}
+
+		void updateDynamicVertexBuffer(VertexBufferHandle _handle, uint32_t _offset, uint32_t _size, const Memory* _mem)
+		{
+			updateDynamic(m_dynamicVertexBuffers[_handle.idx], _offset, _size, _mem);
+		}
+
+		void destroyDynamicVertexBuffer(VertexBufferHandle _handle)
+		{
+			freeDynamic(m_dynamicVertexBuffers[_handle.idx]);
+		}
+
+		// The application gives the bytes of a range of the buffer again after a restore, or stops when the range
+		// goes. The kept bytes of the range go.
+		void restoreByApplication(VertexBufferHandle _handle, uint32_t _offset, uint32_t _size, bool _on)
+		{
+			markDynamic(m_dynamicVertexBuffers[_handle.idx], _offset, _size, _on);
+		}
+
+		void createShader(ShaderHandle _handle, const Memory* _mem)
+		{
+			Buffer& shader = m_shaders[_handle.idx];
+			freeBuffer(shader, KeptShaders);
+			shader.mem = own(_mem);
+			m_kept[KeptShaders] += shader.mem->size;
+		}
+
+		void destroyShader(ShaderHandle _handle)
+		{
+			freeBuffer(m_shaders[_handle.idx], KeptShaders);
+		}
+
+		void createProgram(ProgramHandle _handle, ShaderHandle _vsh, ShaderHandle _fsh)
+		{
+			Program& program = m_programs[_handle.idx];
+			program.live = true;
+			program.vsh  = _vsh;
+			program.fsh  = _fsh;
+		}
+
+		void destroyProgram(ProgramHandle _handle)
+		{
+			m_programs[_handle.idx].live = false;
+		}
+
+		// Takes the create memory and the texel memory in it. A texture of the application's own native
+		// texture cannot be made again, thus only its memory is released.
+		void createTexture(TextureHandle _handle, const Memory* _mem, uint64_t _flags, uint8_t _skip, uint64_t _external)
+		{
+			Texture& texture = m_textures[_handle.idx];
+			freeTexture(texture);
+			if (0 != _external)
+			{
+				releaseTextureMemory(_mem);
+				return;
+			}
+
+			_mem = own(_mem);
+			uint32_t magic = 0;
+			if (sizeof(uint32_t) + sizeof(TextureCreate) <= _mem->size)
+			{
+				bx::memCopy(&magic, _mem->data, sizeof(uint32_t) );
+			}
+
+			if (kChunkMagicTex == magic)
+			{
+				TextureCreate tc;
+				bx::memCopy(&tc, _mem->data + sizeof(uint32_t), sizeof(TextureCreate) );
+				if (NULL != tc.m_mem)
+				{
+					tc.m_mem = own(tc.m_mem);
+					bx::memCopy(_mem->data + sizeof(uint32_t), &tc, sizeof(TextureCreate) );
+					m_kept[KeptTextures] += tc.m_mem->size;
+				}
+			}
+
+			texture.mem   = _mem;
+			texture.flags = _flags;
+			texture.skip  = _skip;
+			m_kept[KeptTextures] += imageBytes(_mem);
+		}
+
+		// Copies the texels of an update into the kept copy of the texture. The caller keeps the memory.
+		void updateTexture(TextureHandle _handle, uint8_t _side, uint8_t _mip, const Rect& _rect, uint16_t _z, uint16_t _depth, uint16_t _pitch, const Memory* _mem)
+		{
+			Texture& texture = m_textures[_handle.idx];
+			if (NULL == texture.mem
+			||  texture.byApplication)
+			{
+				return;
+			}
+
+			if (1 == _depth
+			&&  !texture.resized
+			&&  0 == texture.skip
+			&&  copyIntoSlice(texture, _side, _mip, _rect, _z, _pitch, _mem) )
+			{
+				return;
+			}
+
+			// The update cannot go into a slice: it is kept as it is, and replaces the kept updates that it covers
+			for (uint32_t ii = 0; ii < texture.updates.size(); )
+			{
+				const Update& update = texture.updates[ii];
+				if (update.side == _side
+				&&  update.mip  == _mip
+				&&  covers(_rect, update.rect)
+				&&  _z <= update.z
+				&&  update.z + update.depth <= _z + _depth)
+				{
+					m_kept[KeptTextureChanges] -= update.mem->size;
+					release(update.mem);
+					texture.updates.erase(texture.updates.begin() + ii);
+				}
+				else
+				{
+					++ii;
+				}
+			}
+
+			Update update;
+			update.side  = _side;
+			update.mip   = _mip;
+			update.rect  = _rect;
+			update.z     = _z;
+			update.depth = _depth;
+			update.pitch = _pitch;
+			update.mem   = copy(_mem->data, _mem->size);
+			m_kept[KeptTextureChanges] += update.mem->size;
+			texture.updates.push_back(update);
+		}
+
+		// The application gives the texels of the texture again after a restore. The kept changes go, and the
+		// next updates are not kept.
+		void restoreByApplication(TextureHandle _handle)
+		{
+			Texture& texture = m_textures[_handle.idx];
+			if (NULL == texture.mem)
+			{
+				return;
+			}
+
+			// The slices can point into the texels of the create memory, thus they go first
+			freeChanges(texture);
+			texture.byApplication = true;
+			if (sizeof(uint32_t) + sizeof(TextureCreate) <= texture.mem->size)
+			{
+				uint32_t magic;
+				bx::memCopy(&magic, texture.mem->data, sizeof(uint32_t) );
+				if (kChunkMagicTex == magic)
+				{
+					TextureCreate tc;
+					bx::memCopy(&tc, texture.mem->data + sizeof(uint32_t), sizeof(TextureCreate) );
+					if (NULL != tc.m_mem)
+					{
+						// A restore makes the texture without texels
+						m_kept[KeptTextures] -= tc.m_mem->size;
+						release(tc.m_mem);
+						tc.m_mem = NULL;
+						bx::memCopy(texture.mem->data + sizeof(uint32_t), &tc, sizeof(TextureCreate) );
+					}
+				}
+			}
+		}
+
+		// The contents of a resized texture are not defined, thus the kept changes go
+		void resizeTexture(TextureHandle _handle, uint16_t _width, uint16_t _height, uint8_t _numMips, uint16_t _numLayers)
+		{
+			Texture& texture = m_textures[_handle.idx];
+			if (NULL == texture.mem)
+			{
+				return;
+			}
+
+			freeChanges(texture);
+			texture.resized   = true;
+			texture.width     = _width;
+			texture.height    = _height;
+			texture.numMips   = _numMips;
+			texture.numLayers = _numLayers;
+		}
+
+		void destroyTexture(TextureHandle _handle)
+		{
+			freeTexture(m_textures[_handle.idx]);
+		}
+
+		void createFrameBuffer(FrameBufferHandle _handle, uint8_t _num, const Attachment* _attachment)
+		{
+			FrameBuffer& frameBuffer = m_frameBuffers[_handle.idx];
+			frameBuffer.live   = true;
+			frameBuffer.window = false;
+			frameBuffer.num    = _num;
+			bx::memCopy(frameBuffer.attachment, _attachment, sizeof(Attachment) * _num);
+		}
+
+		void createFrameBuffer(FrameBufferHandle _handle, const SwapChain& _desc)
+		{
+			FrameBuffer& frameBuffer = m_frameBuffers[_handle.idx];
+			frameBuffer.live   = true;
+			frameBuffer.window = true;
+			frameBuffer.desc   = _desc;
+		}
+
+		void destroyFrameBuffer(FrameBufferHandle _handle)
+		{
+			m_frameBuffers[_handle.idx].live = false;
+		}
+
+		void createUniform(UniformHandle _handle, UniformType::Enum _type, uint16_t _num, const char* _name)
+		{
+			Uniform& uniform = m_uniforms[_handle.idx];
+			uniform.live = true;
+			uniform.type = _type;
+			uniform.num  = _num;
+			uniform.name = _name;
+		}
+
+		void destroyUniform(UniformHandle _handle)
+		{
+			m_uniforms[_handle.idx].live = false;
+		}
+
+		// Makes each kept resource again on a new renderer, with its handle and its last contents. The contents
+		// that only the GPU wrote, as in render targets, are not kept.
+		void restore(RendererContextI* _renderCtx)
+		{
+			for (uint16_t ii = 0; ii < m_uniforms.size(); ++ii)
+			{
+				const Uniform& uniform = m_uniforms[ii];
+				if (uniform.live)
+				{
+					_renderCtx->createUniform({ii}, uniform.type, uniform.num, uniform.name.c_str() );
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_vertexLayouts.size(); ++ii)
+			{
+				if (m_vertexLayouts[ii].live)
+				{
+					_renderCtx->createVertexLayout({ii}, m_vertexLayouts[ii].layout);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_indexBuffers.size(); ++ii)
+			{
+				const Buffer& buffer = m_indexBuffers[ii];
+				if (NULL != buffer.mem)
+				{
+					_renderCtx->createIndexBuffer({ii}, buffer.mem, buffer.flags);
+				}
+				else if (buffer.byApplication)
+				{
+					// Zeros until the application gives the contents again
+					const Memory* zeros = zeroed(buffer.size);
+					_renderCtx->createIndexBuffer({ii}, zeros, buffer.flags);
+					release(zeros);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_vertexBuffers.size(); ++ii)
+			{
+				const Buffer& buffer = m_vertexBuffers[ii];
+				if (NULL != buffer.mem)
+				{
+					_renderCtx->createVertexBuffer({ii}, buffer.mem, buffer.layout, buffer.flags);
+				}
+				else if (buffer.byApplication)
+				{
+					// Zeros until the application gives the contents again
+					const Memory* zeros = zeroed(buffer.size);
+					_renderCtx->createVertexBuffer({ii}, zeros, buffer.layout, buffer.flags);
+					release(zeros);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_dynamicIndexBuffers.size(); ++ii)
+			{
+				const Dynamic& buffer = m_dynamicIndexBuffers[ii];
+				if (buffer.live)
+				{
+					_renderCtx->createDynamicIndexBuffer({ii}, buffer.size, buffer.flags);
+					if (const Memory* mem = dynamicContents(buffer) )
+					{
+						_renderCtx->updateDynamicIndexBuffer({ii}, 0, buffer.size, mem);
+						release(mem);
+					}
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_dynamicVertexBuffers.size(); ++ii)
+			{
+				const Dynamic& buffer = m_dynamicVertexBuffers[ii];
+				if (buffer.live)
+				{
+					_renderCtx->createDynamicVertexBuffer({ii}, buffer.size, buffer.flags);
+					if (const Memory* mem = dynamicContents(buffer) )
+					{
+						_renderCtx->updateDynamicVertexBuffer({ii}, 0, buffer.size, mem);
+						release(mem);
+					}
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_shaders.size(); ++ii)
+			{
+				if (NULL != m_shaders[ii].mem)
+				{
+					_renderCtx->createShader({ii}, m_shaders[ii].mem);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_programs.size(); ++ii)
+			{
+				const Program& program = m_programs[ii];
+				if (program.live)
+				{
+					_renderCtx->createProgram({ii}, program.vsh, program.fsh);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_textures.size(); ++ii)
+			{
+				const Texture& texture = m_textures[ii];
+				if (NULL == texture.mem)
+				{
+					continue;
+				}
+
+				const TextureHandle handle = {ii};
+				_renderCtx->createTexture(handle, texture.mem, texture.flags, texture.skip, 0);
+				if (texture.resized)
+				{
+					_renderCtx->resizeTexture(handle, texture.width, texture.height, texture.numMips, texture.numLayers);
+				}
+
+				if (texture.byApplication)
+				{
+					continue;
+				}
+
+				for (const Slice& slice : texture.slices)
+				{
+					// The texels of a slice in the create memory come with the create
+					if (NULL != slice.place
+					||  0 == slice.dirty.m_width)
+					{
+						continue;
+					}
+
+					const uint32_t rowBytes = uint32_t(slice.dirty.m_width) * slice.texelBytes;
+					const Memory* mem = alloc(rowBytes * slice.dirty.m_height);
+					for (uint32_t yy = 0; yy < slice.dirty.m_height; ++yy)
+					{
+						bx::memCopy(
+							  mem->data + yy * rowBytes
+							, slice.bytes.data() + (slice.dirty.m_y + yy) * slice.pitch + slice.dirty.m_x * slice.texelBytes
+							, rowBytes
+							);
+					}
+
+					_renderCtx->updateTexture(handle, slice.side, slice.mip, slice.dirty, slice.z, 1, UINT16_MAX, mem);
+					release(mem);
+				}
+
+				for (const Update& update : texture.updates)
+				{
+					_renderCtx->updateTexture(handle, update.side, update.mip, update.rect, update.z, update.depth, update.pitch, update.mem);
+				}
+			}
+
+			for (uint16_t ii = 0; ii < m_frameBuffers.size(); ++ii)
+			{
+				const FrameBuffer& frameBuffer = m_frameBuffers[ii];
+				if (!frameBuffer.live)
+				{
+					continue;
+				}
+
+				if (frameBuffer.window)
+				{
+					_renderCtx->createFrameBuffer({ii}, frameBuffer.desc);
+				}
+				else
+				{
+					_renderCtx->createFrameBuffer({ii}, frameBuffer.num, frameBuffer.attachment);
+				}
+			}
+		}
+
+		// Releases all kept data, as the renderer stops
+		void clear()
+		{
+			for (Buffer& buffer : m_indexBuffers)
+			{
+				freeBuffer(buffer, KeptBuffers);
+			}
+
+			for (Buffer& buffer : m_vertexBuffers)
+			{
+				freeBuffer(buffer, KeptBuffers);
+			}
+
+			for (Buffer& shader : m_shaders)
+			{
+				freeBuffer(shader, KeptShaders);
+			}
+
+			for (Dynamic& buffer : m_dynamicIndexBuffers)
+			{
+				freeDynamic(buffer);
+			}
+
+			for (Dynamic& buffer : m_dynamicVertexBuffers)
+			{
+				freeDynamic(buffer);
+			}
+
+			for (Texture& texture : m_textures)
+			{
+				freeTexture(texture);
+			}
+
+			for (VertexLayoutKept& layout : m_vertexLayouts)
+			{
+				layout.live = false;
+			}
+
+			for (Program& program : m_programs)
+			{
+				program.live = false;
+			}
+
+			for (FrameBuffer& frameBuffer : m_frameBuffers)
+			{
+				frameBuffer.live = false;
+			}
+
+			for (Uniform& uniform : m_uniforms)
+			{
+				uniform.live = false;
+			}
+		}
+
+	private:
+		struct Buffer
+		{
+			const Memory* mem = NULL;
+			uint32_t size = 0;
+			VertexLayoutHandle layout = BGFX_INVALID_HANDLE;
+			uint16_t flags = 0;
+			bool byApplication = false;
+		};
+
+		// The contents of a dynamic buffer are kept in pages, each made at the first update of a byte in it. A
+		// page goes when it has no kept byte: each byte is in a range that the application gives again, or in the
+		// block of a buffer that went.
+		static constexpr uint32_t kDynamicPageSize = 4096;
+
+		struct Dynamic
+		{
+			bool live = false;
+			uint32_t size = 0;
+			uint16_t flags = 0;
+			// The kept pages, empty where no byte is kept
+			std::vector<std::vector<uint8_t> > pages;
+			// For each kept page, one bit for each byte that the page keeps
+			std::vector<std::vector<uint64_t> > keptBits;
+			// The ranges that the application gives again, by offset, with their size
+			std::map<uint32_t, uint32_t> byApplication;
+			// An update of the buffer occurred
+			bool updated = false;
+		};
+
+		struct VertexLayoutKept
+		{
+			bool live = false;
+			VertexLayout layout;
+		};
+
+		struct Program
+		{
+			bool live = false;
+			ShaderHandle vsh = BGFX_INVALID_HANDLE;
+			ShaderHandle fsh = BGFX_INVALID_HANDLE;
+		};
+
+		// The texels of one mip of one side or layer, with the rectangle that updates changed. The texels are in the
+		// create memory of the texture when it has them, else in a copy of the slice's own.
+		struct Slice
+		{
+			uint8_t* place = NULL;
+			uint8_t side = 0;
+			uint8_t mip = 0;
+			uint16_t z = 0;
+			uint32_t width = 0;
+			uint32_t height = 0;
+			uint32_t texelBytes = 0;
+			uint32_t pitch = 0;
+			Rect dirty;
+			std::vector<uint8_t> bytes;
+		};
+
+		struct Update
+		{
+			uint8_t side = 0;
+			uint8_t mip = 0;
+			Rect rect;
+			uint16_t z = 0;
+			uint16_t depth = 0;
+			uint16_t pitch = 0;
+			const Memory* mem = NULL;
+		};
+
+		struct Texture
+		{
+			const Memory* mem = NULL;
+			uint64_t flags = 0;
+			uint8_t skip = 0;
+			bool resized = false;
+			bool byApplication = false;
+			uint16_t width = 0;
+			uint16_t height = 0;
+			uint8_t numMips = 0;
+			uint16_t numLayers = 0;
+			std::vector<Slice> slices;
+			std::vector<Update> updates;
+		};
+
+		struct FrameBuffer
+		{
+			bool live = false;
+			bool window = false;
+			uint8_t num = 0;
+			Attachment attachment[BGFX_CONFIG_MAX_FRAME_BUFFER_ATTACHMENTS];
+			SwapChain desc;
+		};
+
+		struct Uniform
+		{
+			bool live = false;
+			UniformType::Enum type = UniformType::Count;
+			uint16_t num = 0;
+			std::string name;
+		};
+
+		// Memory that only refers to the data of the application is copied, because the application can
+		// free the data after the release
+		static const Memory* own(const Memory* _mem)
+		{
+			if (!isMemoryRef(_mem) )
+			{
+				return _mem;
+			}
+
+			const Memory* owned = copy(_mem->data, _mem->size);
+			release(_mem);
+			return owned;
+		}
+
+		static bool covers(const Rect& _outer, const Rect& _inner)
+		{
+			return _outer.m_x <= _inner.m_x
+				&& _outer.m_y <= _inner.m_y
+				&& int32_t(_inner.m_x) + _inner.m_width  <= int32_t(_outer.m_x) + _outer.m_width
+				&& int32_t(_inner.m_y) + _inner.m_height <= int32_t(_outer.m_y) + _outer.m_height
+				;
+		}
+
+		// The bytes of the image in the create memory of a texture. The description of a texture without an image
+		// file is not data of the texture, thus it does not count.
+		static uint32_t imageBytes(const Memory* _mem)
+		{
+			if (sizeof(uint32_t) + sizeof(TextureCreate) <= _mem->size)
+			{
+				uint32_t magic;
+				bx::memCopy(&magic, _mem->data, sizeof(uint32_t) );
+				if (kChunkMagicTex == magic)
+				{
+					return 0;
+				}
+			}
+
+			return _mem->size;
+		}
+
+		static void releaseTextureMemory(const Memory* _mem)
+		{
+			if (sizeof(uint32_t) + sizeof(TextureCreate) <= _mem->size)
+			{
+				uint32_t magic;
+				bx::memCopy(&magic, _mem->data, sizeof(uint32_t) );
+				if (kChunkMagicTex == magic)
+				{
+					TextureCreate tc;
+					bx::memCopy(&tc, _mem->data + sizeof(uint32_t), sizeof(TextureCreate) );
+					if (NULL != tc.m_mem)
+					{
+						release(tc.m_mem);
+					}
+				}
+			}
+
+			release(_mem);
+		}
+
+		// Puts the texels of an update of an uncompressed texture into its slice. False when the texture or the
+		// update does not fit a slice.
+		static uint8_t* texels(Slice& _slice)
+		{
+			return NULL != _slice.place ? _slice.place : _slice.bytes.data();
+		}
+
+		bool copyIntoSlice(Texture& _texture, uint8_t _side, uint8_t _mip, const Rect& _rect, uint16_t _z, uint16_t _pitch, const Memory* _mem)
+		{
+			Slice* slice = NULL;
+			for (Slice& each : _texture.slices)
+			{
+				if (each.side == _side
+				&&  each.mip  == _mip
+				&&  each.z    == _z)
+				{
+					slice = &each;
+					break;
+				}
+			}
+
+			if (NULL == slice)
+			{
+				slice = makeSlice(_texture, _side, _mip, _z);
+				if (NULL == slice)
+				{
+					return false;
+				}
+			}
+
+			const uint32_t rowBytes = uint32_t(_rect.m_width) * slice->texelBytes;
+			const uint32_t srcPitch = UINT16_MAX == _pitch ? rowBytes : _pitch;
+			if (0 == _rect.m_width
+			||  0 == _rect.m_height
+			||  0 > _rect.m_x
+			||  0 > _rect.m_y
+			||  uint32_t(_rect.m_x) + _rect.m_width  > slice->width
+			||  uint32_t(_rect.m_y) + _rect.m_height > slice->height
+			||  srcPitch < rowBytes
+			||  uint64_t(_rect.m_height - 1) * srcPitch + rowBytes > _mem->size)
+			{
+				return false;
+			}
+
+			for (uint32_t yy = 0; yy < _rect.m_height; ++yy)
+			{
+				bx::memCopy(
+					  texels(*slice) + (_rect.m_y + yy) * slice->pitch + _rect.m_x * slice->texelBytes
+					, _mem->data + yy * srcPitch
+					, rowBytes
+					);
+			}
+
+			if (0 == slice->dirty.m_width)
+			{
+				slice->dirty = _rect;
+			}
+			else
+			{
+				const int32_t x0 = bx::min<int32_t>(slice->dirty.m_x, _rect.m_x);
+				const int32_t y0 = bx::min<int32_t>(slice->dirty.m_y, _rect.m_y);
+				const int32_t x1 = bx::max<int32_t>(slice->dirty.m_x + slice->dirty.m_width,  _rect.m_x + _rect.m_width);
+				const int32_t y1 = bx::max<int32_t>(slice->dirty.m_y + slice->dirty.m_height, _rect.m_y + _rect.m_height);
+				slice->dirty.set(int16_t(x0), int16_t(y0), uint16_t(x1 - x0), uint16_t(y1 - y0) );
+			}
+
+			return true;
+		}
+
+		// A slice of an uncompressed 2D, array or cube texture, with the texels of its create memory, or zero
+		Slice* makeSlice(Texture& _texture, uint8_t _side, uint8_t _mip, uint16_t _z)
+		{
+			bimg::ImageContainer container;
+			bx::Error err;
+			if (!bimg::imageParse(container, _texture.mem->data, _texture.mem->size, &err)
+			||  1 < container.m_depth
+			||  _mip >= container.m_numMips)
+			{
+				return NULL;
+			}
+
+			const bimg::ImageBlockInfo& blockInfo = bimg::getBlockInfo(container.m_format);
+			if (1 != blockInfo.blockWidth
+			||  1 != blockInfo.blockHeight
+			||  0 != blockInfo.bitsPerPixel % 8
+			||  0 == blockInfo.bitsPerPixel)
+			{
+				return NULL;
+			}
+
+			const uint16_t sides = container.m_cubeMap ? 6 : 1;
+			if (_side >= sides
+			||  _z >= container.m_numLayers)
+			{
+				return NULL;
+			}
+
+			Slice slice;
+			slice.side       = _side;
+			slice.mip        = _mip;
+			slice.z          = _z;
+			slice.width      = bx::max<uint32_t>(1, container.m_width  >> _mip);
+			slice.height     = bx::max<uint32_t>(1, container.m_height >> _mip);
+			slice.texelBytes = blockInfo.bitsPerPixel / 8;
+			slice.pitch      = slice.width * slice.texelBytes;
+			slice.dirty.clear();
+
+			// The updates go into the texels of the create memory, which the renderer keeps as its own copy. A
+			// texture without texels gets a slice of zeros.
+			const uint32_t size = slice.pitch * slice.height;
+			bimg::ImageMip mip;
+			if ( (NULL != container.m_data || UINT32_MAX != container.m_offset)
+			&&  bimg::imageGetRawData(container, uint16_t(_z * sides + _side), _mip, _texture.mem->data, _texture.mem->size, mip)
+			&&  mip.m_size == size)
+			{
+				slice.place = const_cast<uint8_t*>(mip.m_data);
+			}
+			else
+			{
+				slice.bytes.resize(size, 0);
+				m_kept[KeptTextureChanges] += slice.bytes.size();
+			}
+
+			_texture.slices.push_back(std::move(slice) );
+			return &_texture.slices.back();
+		}
+
+		void freeBuffer(Buffer& _buffer, Kept _kind)
+		{
+			if (NULL != _buffer.mem)
+			{
+				m_kept[_kind] -= _buffer.mem->size;
+				release(_buffer.mem);
+			}
+
+			_buffer = Buffer();
+		}
+
+		// The kept contents of a live buffer go; the buffer keeps its size, layout and flags
+		void giveUpContents(Buffer& _buffer)
+		{
+			if (NULL == _buffer.mem)
+			{
+				return;
+			}
+
+			m_kept[KeptBuffers] -= _buffer.mem->size;
+			release(_buffer.mem);
+			_buffer.mem = NULL;
+			_buffer.byApplication = true;
+		}
+
+		// Memory of zeros, at least one byte
+		static const Memory* zeroed(uint32_t _size)
+		{
+			const Memory* mem = alloc(bx::max<uint32_t>(_size, 1) );
+			bx::memSet(mem->data, 0, mem->size);
+			return mem;
+		}
+
+		void createDynamic(Dynamic& _buffer, uint32_t _size, uint16_t _flags)
+		{
+			freeDynamic(_buffer);
+			_buffer.live  = true;
+			_buffer.size  = _size;
+			_buffer.flags = _flags;
+			const uint32_t numPages = (_size + kDynamicPageSize - 1) / kDynamicPageSize;
+			_buffer.pages.resize(numPages);
+			_buffer.keptBits.resize(numPages);
+		}
+
+		static uint32_t pageLength(const Dynamic& _buffer, uint32_t _page)
+		{
+			return bx::min(kDynamicPageSize, _buffer.size - _page * kDynamicPageSize);
+		}
+
+		// Copies bytes into the kept pages, and makes the pages that they need
+		void keepDynamic(Dynamic& _buffer, uint32_t _offset, const uint8_t* _data, uint32_t _size)
+		{
+			while (0 < _size)
+			{
+				const uint32_t page = _offset / kDynamicPageSize;
+				const uint32_t start = _offset - page * kDynamicPageSize;
+				const uint32_t length = bx::min(_size, pageLength(_buffer, page) - start);
+				std::vector<uint8_t>& bytes = _buffer.pages[page];
+				if (bytes.empty() )
+				{
+					bytes.resize(pageLength(_buffer, page), 0);
+					_buffer.keptBits[page].assign(kDynamicPageSize / 64, 0);
+					m_kept[KeptDynamicBuffers] += bytes.size();
+				}
+
+				bx::memCopy(bytes.data() + start, _data, length);
+				setBits(_buffer.keptBits[page], start, length, true);
+				_offset += length;
+				_data   += length;
+				_size   -= length;
+			}
+		}
+
+		// Keeps the bytes of an update that are not in a range that the application gives again
+		void updateDynamic(Dynamic& _buffer, uint32_t _offset, uint32_t _size, const Memory* _mem)
+		{
+			if (!_buffer.live
+			||  _offset >= _buffer.size)
+			{
+				return;
+			}
+
+			_buffer.updated = true;
+			const uint32_t end = _offset + bx::min(bx::min(_size, _mem->size), _buffer.size - _offset);
+			uint32_t at = _offset;
+			std::map<uint32_t, uint32_t>::const_iterator range = _buffer.byApplication.upper_bound(_offset);
+			if (range != _buffer.byApplication.begin() )
+			{
+				--range;
+			}
+
+			for (; at < end && range != _buffer.byApplication.end(); ++range)
+			{
+				const uint32_t rangeEnd = range->first + range->second;
+				if (rangeEnd <= at)
+				{
+					continue;
+				}
+
+				if (range->first >= end)
+				{
+					break;
+				}
+
+				if (range->first > at)
+				{
+					keepDynamic(_buffer, at, _mem->data + (at - _offset), range->first - at);
+				}
+
+				at = bx::max(at, rangeEnd);
+			}
+
+			if (at < end)
+			{
+				keepDynamic(_buffer, at, _mem->data + (at - _offset), end - at);
+			}
+		}
+
+		// Adds a range that the application gives again, or removes it when its buffer goes. In both cases the
+		// bytes of the range are no longer kept: the application gives them, or no buffer uses them. A page without
+		// kept bytes goes.
+		void markDynamic(Dynamic& _buffer, uint32_t _offset, uint32_t _size, bool _on)
+		{
+			if (!_buffer.live
+			||  _offset >= _buffer.size)
+			{
+				return;
+			}
+
+			const uint32_t size = bx::min(_size, _buffer.size - _offset);
+			if (_on)
+			{
+				_buffer.byApplication[_offset] = size;
+			}
+			else
+			{
+				_buffer.byApplication.erase(_offset);
+			}
+
+			for (uint32_t at = _offset, end = _offset + size; at < end; )
+			{
+				const uint32_t page = at / kDynamicPageSize;
+				const uint32_t start = at - page * kDynamicPageSize;
+				const uint32_t length = bx::min(end - at, pageLength(_buffer, page) - start);
+				std::vector<uint8_t>& bytes = _buffer.pages[page];
+				if (!bytes.empty() )
+				{
+					std::vector<uint64_t>& bits = _buffer.keptBits[page];
+					setBits(bits, start, length, false);
+					if (noBits(bits) )
+					{
+						m_kept[KeptDynamicBuffers] -= bytes.size();
+						std::vector<uint8_t>().swap(bytes);
+						std::vector<uint64_t>().swap(bits);
+					}
+					else
+					{
+						bx::memSet(bytes.data() + start, 0, length);
+					}
+				}
+
+				at += length;
+			}
+		}
+
+		static void setBits(std::vector<uint64_t>& _bits, uint32_t _start, uint32_t _length, bool _on)
+		{
+			for (uint32_t ii = _start, end = _start + _length; ii < end; ++ii)
+			{
+				const uint64_t bit = uint64_t(1) << (ii % 64);
+				if (_on)
+				{
+					_bits[ii / 64] |= bit;
+				}
+				else
+				{
+					_bits[ii / 64] &= ~bit;
+				}
+			}
+		}
+
+		static bool noBits(const std::vector<uint64_t>& _bits)
+		{
+			for (uint64_t word : _bits)
+			{
+				if (0 != word)
+				{
+					return false;
+				}
+			}
+
+			return true;
+		}
+
+		// The contents to give a new buffer: the kept pages, with zeros in the other bytes. NULL when the buffer had
+		// no update.
+		static const Memory* dynamicContents(const Dynamic& _buffer)
+		{
+			if (!_buffer.updated)
+			{
+				return NULL;
+			}
+
+			const Memory* mem = zeroed(_buffer.size);
+			for (uint32_t page = 0; page < _buffer.pages.size(); ++page)
+			{
+				const std::vector<uint8_t>& bytes = _buffer.pages[page];
+				if (!bytes.empty() )
+				{
+					bx::memCopy(mem->data + page * kDynamicPageSize, bytes.data(), bytes.size() );
+				}
+			}
+
+			return mem;
+		}
+
+		void freeDynamic(Dynamic& _buffer)
+		{
+			for (const std::vector<uint8_t>& bytes : _buffer.pages)
+			{
+				m_kept[KeptDynamicBuffers] -= bytes.size();
+			}
+
+			_buffer = Dynamic();
+		}
+
+		void freeChanges(Texture& _texture)
+		{
+			for (const Slice& slice : _texture.slices)
+			{
+				m_kept[KeptTextureChanges] -= slice.bytes.size();
+			}
+
+			for (const Update& update : _texture.updates)
+			{
+				m_kept[KeptTextureChanges] -= update.mem->size;
+				release(update.mem);
+			}
+
+			std::vector<Slice>().swap(_texture.slices);
+			std::vector<Update>().swap(_texture.updates);
+		}
+
+		void freeTexture(Texture& _texture)
+		{
+			if (NULL == _texture.mem)
+			{
+				return;
+			}
+
+			freeChanges(_texture);
+			m_kept[KeptTextures] -= imageBytes(_texture.mem);
+			if (sizeof(uint32_t) + sizeof(TextureCreate) <= _texture.mem->size)
+			{
+				uint32_t magic;
+				bx::memCopy(&magic, _texture.mem->data, sizeof(uint32_t) );
+				if (kChunkMagicTex == magic)
+				{
+					TextureCreate tc;
+					bx::memCopy(&tc, _texture.mem->data + sizeof(uint32_t), sizeof(TextureCreate) );
+					if (NULL != tc.m_mem)
+					{
+						m_kept[KeptTextures] -= tc.m_mem->size;
+					}
+				}
+			}
+
+			releaseTextureMemory(_texture.mem);
+			_texture = Texture();
+		}
+
+		std::vector<Buffer>           m_indexBuffers;
+		std::vector<VertexLayoutKept> m_vertexLayouts;
+		std::vector<Buffer>           m_vertexBuffers;
+		std::vector<Dynamic>          m_dynamicIndexBuffers;
+		std::vector<Dynamic>          m_dynamicVertexBuffers;
+		std::vector<Buffer>           m_shaders;
+		std::vector<Program>          m_programs;
+		std::vector<Texture>          m_textures;
+		std::vector<FrameBuffer>      m_frameBuffers;
+		std::vector<Uniform>          m_uniforms;
+		uint64_t                      m_kept[KeptCount] = {};
+	};
+
+} // namespace bgfx
