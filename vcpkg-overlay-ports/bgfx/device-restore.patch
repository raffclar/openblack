+	void Context::restoreDevice(RendererType::Enum _type)
+	{
+		rendererDestroy(m_renderCtx);
+
+		// The same renderer on the same window, at the size and with the settings of the last frame
+		Init init = m_init;
+		init.type      = _type;
+		init.fallback  = false;
+		init.swapChain = m_render->m_mainSwapChain;
+		init.reset     = m_render->m_reset;
+
+		RendererContextI* renderCtx = s_rendererCreator[_type].supported
+			? s_rendererCreator[_type].createFn(init)
+			: NULL
+			;
+
+		if (NULL == renderCtx)
+		{
+			// The device cannot be made now, as while the driver resets. The frames go to the noop renderer,
+			// which keeps the resources, and the renderer tries again after one second.
+			BX_TRACE("The %s renderer could not make its device again.", s_rendererCreator[_type].name);
+
+			Init noop;
+			noop.type = RendererType::Noop;
+			m_renderCtx = s_rendererCreator[RendererType::Noop].createFn(noop);
+			g_caps.rendererType = RendererType::Noop;
+			m_restoreType = _type;
+			m_restoreRetryAt = bx::getHPCounter() + bx::getHPFrequency();
+			return;
+		}
+
+		m_renderCtx = renderCtx;
+		g_caps.rendererType = _type;
+		m_restoreType = RendererType::Count;
+
+		m_deviceRestore.restore(m_renderCtx);
+		m_textVideoMemBlitter.giveTexelsAgain(m_renderCtx);
+		m_restoreCount.fetch_add(1);
+
+		BX_TRACE("The %s renderer made its device again with %" PRIu64 " kept bytes."
+			, s_rendererCreator[_type].name
+			, m_deviceRestore.keptBytes()
+			);
+	}
