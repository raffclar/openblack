+				// it or in lists before it. The page waits for one value more: the first value that the queue
+				// signals is the start value of the fence, thus it does not show that the GPU is done.
+				m_stagingPage.m_fence = m_currentFence + 1;
+				m_stagingFull.push_back(m_stagingPage);
+				m_stagingPage = { NULL, NULL, 0 };
