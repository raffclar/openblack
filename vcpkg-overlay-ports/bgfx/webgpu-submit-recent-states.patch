+		// The values of one binding that addBindingFormats and addBindingLayoutKey read.
+		struct BindingLayoutKey
+		{
+			WGPUTextureFormat        fmt;
+			WGPUTextureViewDimension viewDimension;
+			uint8_t                  textureFormat;
+			uint8_t                  access;
+			bool                     hasFormat;
+			bool                     unbound;
+			bool                     sampleStencil;
+		};
+
+		BindingLayoutKey getBindingLayoutKey(const ShaderBinding& _shaderBind, const Binding& _bind) const
+		{
+			BindingLayoutKey key;
+			bx::memSet(&key, 0, sizeof(key) );
+
+			if (kInvalidHandle != _bind.m_idx
+			&&  (Binding::Image == _bind.m_type || Binding::Texture == _bind.m_type) )
+			{
+				const TextureWGPU& texture = m_textures[_bind.m_idx];
+				key.hasFormat     = true;
+				key.fmt           = texture.m_fmt;
+				key.textureFormat = texture.m_textureFormat;
+				key.viewDimension = texture.m_viewDimension;
+			}
+
+			if (ShaderBinding::Type::Image == _shaderBind.type)
+			{
+				key.access = _bind.m_access;
+			}
+			else if (ShaderBinding::Type::Sampler == _shaderBind.type)
+			{
+				key.unbound = kInvalidHandle == _bind.m_idx;
+				const uint32_t resolvedFlags = key.unbound ? 0
+					: 0 == (BGFX_SAMPLER_INTERNAL_DEFAULT & _bind.m_samplerFlags)
+					? _bind.m_samplerFlags
+					: uint32_t(m_textures[_bind.m_idx].m_flags)
+					;
+				key.sampleStencil = 0 != (resolvedFlags & BGFX_SAMPLER_SAMPLE_STENCIL);
+			}
+
+			return key;
+		}
+
+		// Returns true when the pipeline keys of the two bindings of a program are the same. The textures and
+		// samplers can be different.
+		bool sameBindingLayout(const ProgramWGPU& _program, const Binding* _kept, const RenderBind& _renderBind) const
+		{
+			for (uint32_t stage = 0; stage < BGFX_CONFIG_MAX_TEXTURE_SAMPLERS; ++stage)
+			{
+				const ShaderBinding& shaderBind = _program.m_shaderBinding[stage];
+
+				if (!isValid(shaderBind.uniformHandle)
+				||  0 == bx::memCmp(&_kept[stage], &_renderBind.m_bind[stage], sizeof(Binding) ) )
+				{
+					continue;
+				}
+
+				const BindingLayoutKey kept = getBindingLayoutKey(shaderBind, _kept[stage]);
+				const BindingLayoutKey bind = getBindingLayoutKey(shaderBind, _renderBind.m_bind[stage]);
+
+				if (kept.hasFormat     != bind.hasFormat
+				||  kept.fmt           != bind.fmt
+				||  kept.textureFormat != bind.textureFormat
+				||  kept.viewDimension != bind.viewDimension
+				||  kept.access        != bind.access
+				||  kept.unbound       != bind.unbound
+				||  kept.sampleStencil != bind.sampleStencil)
+				{
+					return false;
+				}
+			}
+
+			return true;
+		}
