+		// A shader can have a texture that a draw does not set. WebGPU needs an entry for each binding of the
+		// layout, thus such a binding gets a 1x1 black texture of the dimension that the shader has, and a
+		// default sampler. The layout takes the binding as a filterable float texture.
+		WGPUTextureView getUnboundTextureView(WGPUTextureViewDimension _dimension)
+		{
+			const uint32_t idx = WGPUTextureViewDimension_2DArray == _dimension ? 1
+				: WGPUTextureViewDimension_Cube    == _dimension ? 2
+				: WGPUTextureViewDimension_3D      == _dimension ? 3
+				: 0
+				;
+
+			if (NULL == m_unboundTextureView[idx])
+			{
+				const uint32_t layers = 2 == idx ? 6 : 1;
+
+				// WebGPU fills a new texture with zeros: black with zero alpha.
+				const WGPUTextureDescriptor textureDesc =
+				{
+					.nextInChain     = NULL,
+					.label           = toWGPUStringView("Unbound"),
+					.usage           = WGPUTextureUsage_TextureBinding,
+					.dimension       = 3 == idx ? WGPUTextureDimension_3D : WGPUTextureDimension_2D,
+					.size            = { 1, 1, layers },
+					.format          = WGPUTextureFormat_RGBA8Unorm,
+					.mipLevelCount   = 1,
+					.sampleCount     = 1,
+					.viewFormatCount = 0,
+					.viewFormats     = NULL,
+				};
+
+				m_unboundTexture[idx] = WGPU_CHECK(wgpuDeviceCreateTexture(m_device, &textureDesc) );
+
+				const WGPUTextureViewDescriptor viewDesc =
+				{
+					.nextInChain     = NULL,
+					.label           = toWGPUStringView("Unbound"),
+					.format          = WGPUTextureFormat_RGBA8Unorm,
+					.dimension       = 0 == idx ? WGPUTextureViewDimension_2D
+						: 1 == idx ? WGPUTextureViewDimension_2DArray
+						: 2 == idx ? WGPUTextureViewDimension_Cube
+						: WGPUTextureViewDimension_3D
+						,
+					.baseMipLevel    = 0,
+					.mipLevelCount   = 1,
+					.baseArrayLayer  = 0,
+					.arrayLayerCount = layers,
+					.aspect          = WGPUTextureAspect_All,
+					.usage           = WGPUTextureUsage_TextureBinding,
+				};
+
+				m_unboundTextureView[idx] = WGPU_CHECK(wgpuTextureCreateView(m_unboundTexture[idx], &viewDesc) );
+			}
+
+			return m_unboundTextureView[idx];
+		}
+
+		WGPUSampler getUnboundSampler()
+		{
+			if (NULL == m_unboundSampler)
+			{
+				m_unboundSampler = WGPU_CHECK(wgpuDeviceCreateSampler(m_device, NULL) );
+			}
+
+			return m_unboundSampler;
+		}
