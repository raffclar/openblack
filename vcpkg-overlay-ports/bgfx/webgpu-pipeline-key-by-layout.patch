+		// Adds the values of the bindings that fillBindGroupLayoutEntry reads, other than the formats that
+		// addBindingFormats adds: if a sampler stage has a texture, if the sampler reads the stencil, and the
+		// access of an image.
+		void addBindingLayoutKey(bx::HashMurmur3& _murmur, const ProgramWGPU& _program, const RenderBind& _renderBind) const
+		{
+			for (uint32_t stage = 0; stage < BGFX_CONFIG_MAX_TEXTURE_SAMPLERS; ++stage)
+			{
+				const ShaderBinding& shaderBind = _program.m_shaderBinding[stage];
+
+				if (!isValid(shaderBind.uniformHandle) )
+				{
+					continue;
+				}
+
+				const Binding& bind = _renderBind.m_bind[stage];
+
+				if (ShaderBinding::Type::Image == shaderBind.type)
+				{
+					_murmur.add(bind.m_access);
+				}
+				else if (ShaderBinding::Type::Sampler == shaderBind.type)
+				{
+					const bool unbound = kInvalidHandle == bind.m_idx;
+					const uint32_t resolvedFlags = unbound ? 0
+						: 0 == (BGFX_SAMPLER_INTERNAL_DEFAULT & bind.m_samplerFlags)
+						? bind.m_samplerFlags
+						: uint32_t(m_textures[bind.m_idx].m_flags)
+						;
+
+					_murmur.add(unbound);
+					_murmur.add(0 != (resolvedFlags & BGFX_SAMPLER_SAMPLE_STENCIL) );
+				}
+			}
+		}
+
