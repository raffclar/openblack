// The configure step writes this file into the build folder from the cache value OPENBLACK_SENTRY_DSN. Do not keep
// the written file in the repository.

#include <string_view>

namespace openblack::error_reports
{

std::string_view BuildDsn() noexcept
{
	return "@OPENBLACK_SENTRY_DSN@";
}

} // namespace openblack::error_reports
